# ==============================================================================
# SMART CAMERA EDGE SYSTEM - CONFIGURATION ENVIRONMENT FILE TEMPLATE
# Copy this file to .env and configure it before running the service.
# ==============================================================================

# IP Address of the Camera
CAMERA_IP=192.168.10.152

# RTSP Stream URL of the Camera (for YOLO Person Detection)
CAMERA_RTSP_URL=rtsp://admin:Demo%402024@192.168.10.152:554/Streaming/Channels/102

# IP Address of the Central Station (Server / Dashboard)
CENTRAL_STATION_IP=192.168.10.102

# Path to the compiled TensorRT Engine model
YOLO_ENGINE_PATH=models/yolov8n.engine

# Confidence threshold for person detection (0.0 to 1.0)
YOLO_CONF_THRESHOLD=0.55

# Timeout in seconds for prediction API callback requests
PREDICTION_CALLBACK_TIMEOUT=5
